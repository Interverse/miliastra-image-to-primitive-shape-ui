.venv
__pycache__/
*.pyc
build/
dist/
# Bundled browser modules must ship with the website.
!js/vendor/primeval/dist/
!js/vendor/primeval/dist/**
/.pages-site/
*.spec
win/build/
win/dist/

# GIA Workspace (legacy backend; the deployable site uses assets/ instead)
gia/*
!gia/template.gia
!gia/convert_to_classic.pyc
!gia/json_to_gia.pyc
!gia/json_to_gia.pyd

.vscode/
tools/
third_party/primitive/bot/
third_party/primitive/examples/
third_party/primitive/scripts/

# Local references, non-runtime archive, research reports and benchmarks
reference/

# Parity-test generated artifacts (regenerate: gen_goldens.py / go build)
tests/parity/*/goldens/
tests/parity/e2e/_trig_req.json
tests/parity/e2e/_trig_res.json
tests/parity/fill/harness.exe
tests/parity/fill/*_golden.json
tests/parity/fill/rng_err.txt

# shapely suite regenerable goldens
tests/parity/shapely/decision_log.jsonl
tests/parity/shapely/goldens.json
tests/parity/shapely/simplify.json
tests/parity/shapely/_unit_circles.json

# Local dependencies and test output
node_modules/
test-results/
playwright-report/

# Local tool configuration (dev-server preview, editor/agent settings)
.claude/

# Cargo build output if the pinned engine is built in place
# (scripts/build-primeval.py uses reference/ instead)
third_party/primeval/target/

# Test caches and OS clutter
.pytest_cache/
.DS_Store
Thumbs.db
# Local replacement scripts generated from user-supplied animation media
/Lua/optimized_gif_compact.lua
/Lua/optimized_gif_lossless.lua

/Lua/original_gif_loading_fix.lua
/Lua/gif_performance.lua
